{
  "permissions": {
    "allow": [
      "Bash(open *)",
      "Bash(npx create-expo-app@latest *)",
      "Read(//usr/local/**)",
      "Read(//opt/homebrew/bin/**)",
      "Bash(export PATH=\"$PATH:/usr/local/bin:/opt/homebrew/bin:/usr/bin\")",
      "Bash(/opt/homebrew/bin/brew --version)",
      "Bash(/usr/local/bin/brew --version)",
      "Bash(npm --version)",
      "Bash(npx --version)",
      "Bash(/opt/homebrew/bin/node --version)",
      "Bash(/opt/homebrew/bin/npm --version)",
      "Bash(/opt/homebrew/bin/brew list *)",
      "Bash(/opt/homebrew/bin/brew info *)",
      "Bash(/opt/homebrew/bin/brew install *)",
      "Bash(export PATH=\"/opt/homebrew/bin:$PATH\")",
      "Bash(npx expo *)",
      "Bash(npx tsc *)",
      "Bash(git *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "export PATH=\"/opt/homebrew/bin:$PATH\"; cd /Users/rubendossantos/Documents/Claudecodetest; git add -A && git diff --cached --quiet || git commit -m \"auto: wijzigingen opgeslagen $(date '+%Y-%m-%d %H:%M')\" && git push origin main 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Wijzigingen opslaan naar GitHub..."
          }
        ]
      }
    ]
  }
}
